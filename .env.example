# Local environment template. In Vercel, add these in Project Settings > Environment Variables.
APP_ENV=production
APP_BASE_URL=https://study.example.com
ADMIN_BASE_URL=https://admin.example.com
ADMIN_HOST=admin.example.com
ADMIN_IP_ALLOWLIST=
SECURE_COOKIE=true

# MySQL 8 / MariaDB connection (use a public TLS-enabled managed database host).
DB_DSN=mysql:host=YOUR_MYSQL_HOST;port=3306;dbname=YOUR_DATABASE;charset=utf8mb4
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=replace-with-database-password

# PDF payloads are stored in MySQL because Vercel's container filesystem is temporary.
CSM_MAX_UPLOAD_BYTES=4000000

# Email bridge (Mailer runs inside the PHP container and binds to localhost).
CSM_MAILER_URL=http://127.0.0.1:8091/send
CSM_MAILER_SECRET=replace-with-a-random-64-character-secret
NODE_ENV=production
MAILER_TRANSPORT=smtp
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=YOUR_SMTP_USERNAME
SMTP_PASS=replace-with-smtp-password
SMTP_FROM=Co-StudyMaxx <noreply@example.com>

# Optional server-side AI generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
